#!/bin/sh
# Instituto Elo Animal – .githooks/commit-msg
# Recusa mensagens de commit fora do padrão Conventional Commits.
# Ative uma vez com: npm run hooks   (git config core.hooksPath .githooks)

primeira_linha=$(head -n 1 "$1")

# Mensagens criadas pelo próprio Git (merge, revert, fixup) são aceitas
case "$primeira_linha" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

padrao='^(feat|fix|perf|docs|style|refactor|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].{0,98}[^.]$'

if printf '%s' "$primeira_linha" | grep -Eq "$padrao"; then
  exit 0
fi

echo "Mensagem de commit fora do padrão Conventional Commits:" >&2
echo "  $primeira_linha" >&2
echo "" >&2
echo "Use: tipo(escopo opcional): resumo em minúsculas, sem ponto final (até 100 caracteres)" >&2
echo "Tipos: feat, fix, perf, docs, style, refactor, test, build, ci, chore, revert" >&2
echo "Exemplo: fix(cadastro): não vincula doação a campanha encerrada" >&2
exit 1
